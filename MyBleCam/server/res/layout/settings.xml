<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="服务端名称（BLE 广播名）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MyBleCamS"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="默认摄像头（Start 时生效）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_cam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="默认画质（Start 时生效）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="预览旋转角度（画面方向不正时手动调整）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/sp_rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="连接成功后执行的 SH 命令（App 权限，输出回显日志）"
            android:textColor="#333333"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_connect_cmd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如: logcat -d -t 5"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:text="断开连接后执行的 SH 命令"
            android:textColor="#333333"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_disc_cmd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="留空则不执行"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
