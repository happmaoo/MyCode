<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bar_bg"
        android:elevation="1dp"
        app:popupTheme="@style/ThemeOverlay.App.Popup"
        app:theme="@style/ThemeOverlay.App.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 运行 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_run" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_auto_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auto_start"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_start_desc" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_open_ui"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/open_ui"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_ui_desc" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- 摄像头 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera" />

            <RadioGroup
                android:id="@+id/rg_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rb_camera_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/camera_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_camera_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/camera_back"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_camera_front"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/camera_front"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- 画面 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_frame" />

            <RadioGroup
                android:id="@+id/rg_rotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <RadioButton
                    android:id="@+id/rb_rot_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rotation_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_rot_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rotation_0"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_rot_90"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rotation_90"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_rot_180"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rotation_180"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_rot_270"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/rotation_270"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rotation_desc" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- 系统 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_battery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/battery" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bluetooth"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/bluetooth_settings" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
