<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bar_bg"
        android:elevation="1dp"
        app:popupTheme="@style/ThemeOverlay.App.Popup"
        app:theme="@style/ThemeOverlay.App.Toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 连接 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_connection" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/server_mac"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/et_mac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/server_mac_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textCapCharacters"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/server_mac_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pick_device"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pick_device" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_auto_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/auto_connect"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_connect_desc" />

            <CheckBox
                android:id="@+id/cb_auto_reconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/auto_reconnect"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_reconnect_desc" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/divider" />

            <!-- 默认参数 -->
            <TextView
                style="@style/TextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_defaults" />

            <RadioGroup
                android:id="@+id/rg_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_res_640"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/res_640"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb_res_320"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/res_320"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </RadioGroup>

            <Spinner
                android:id="@+id/sp_bitrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:popupBackground="@android:color/white"
                android:spinnerMode="dropdown" />

            <CheckBox
                android:id="@+id/cb_auto_bitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/auto_bitrate"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/TextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/defaults_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/save" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
