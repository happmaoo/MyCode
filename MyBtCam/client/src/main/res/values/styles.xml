<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bar_bg</item>
        <item name="colorPrimaryDark">@color/bar_bg_dark</item>
        <item name="colorPrimaryVariant">@color/bar_bg_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/bar_bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorEdgeEffect">@color/bar_bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 三点菜单弹出不做动画 -->
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="android:popupAnimationStyle">@null</item>
    </style>

    <!-- 溢出菜单：去掉展开/收起动画，白底 + 轻阴影 -->
    <style name="AppOverflowMenu" parent="Widget.AppCompat.Light.PopupMenu.Overflow">
        <item name="android:popupAnimationStyle">@null</item>
        <item name="android:popupEnterTransition">@null</item>
        <item name="android:popupExitTransition">@null</item>
        <item name="android:popupBackground">@android:color/white</item>
        <item name="android:popupElevation">6dp</item>
        <item name="overlapAnchor">true</item>
    </style>

    <!-- Toolbar 用浅色 overlay，让三点菜单图标是深色的 -->
    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.App.Popup" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:background">@android:color/white</item>
    </style>

    <style name="TextSection">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextState">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

</resources>
