<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@color/surface">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">

        <TextView android:id="@+id/peer_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_primary"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />

        <TextView android:id="@+id/peer_info" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textColor="@color/text_secondary" android:textSize="11sp"
            android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>

    <Button android:id="@+id/btn_connect" android:layout_width="wrap_content"
        android:layout_height="34dp" android:minWidth="0dp"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:text="@string/btn_connect" android:textSize="12sp"
        style="?android:attr/borderlessButtonStyle" />
</LinearLayout>
