<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="6dp">

    <!-- 顶部：自动换行复选框 + 字号 +/- + Copy / Clear（主界面风格，右侧对齐） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="自动换行"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_font_down"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A-" />

        <Button
            android:id="@+id/btn_font_up"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A+" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_shell_copy"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy" />

        <Button
            android:id="@+id/btn_shell_clear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear" />
    </LinearLayout>

    <!-- 中间：最大区域，ScrollView(纵向) + HorizontalScrollView(横向) + TextView 渲染日志。
         自动换行开启时 TextView 占满宽度折行；关闭时横向可滚动查看长行。 -->
    <HorizontalScrollView
        android:id="@+id/hsv_shell_out"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <ScrollView
            android:id="@+id/sv_shell_out"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:id="@+id/tv_shell_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="#FFFFFF"
                android:scrollbars="vertical"
                android:textIsSelectable="true" />
        </ScrollView>
    </HorizontalScrollView>

    <!-- 命令面板（与主界面一致：Quick Commands / History 两个 Tab） -->
    <LinearLayout
        android:id="@+id/ll_cmdpad_shell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFA"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tab_shell_quick"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="#E8F0FE"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="Quick Commands"
                android:textSize="12sp" />

            <Button
                android:id="@+id/tab_shell_hist"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="History"
                android:textSize="12sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/lv_cmdpad_shell"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#FFFFFF"
            android:cacheColorHint="#00000000" />
    </LinearLayout>

    <!-- 底部：多行命令输入框 + 右侧历史上下箭头。
         用 RelativeLayout：箭头列 alignTop/alignBottom 到输入框，高度被强制拉伸成
         「输入框的上下边」，两个按钮各占一半（weight），所以它们之间 0 间距、边界完全贴合。 -->
    <RelativeLayout
        android:id="@+id/ll_shell_cmdrow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_shell_cmd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="45dp"
            android:minLines="3"
            android:gravity="top"
            android:background="#F5F5F5"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:fontFamily="monospace"
            android:inputType="textMultiLine|textNoSuggestions"
            android:hint="bash command"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/arrow_col"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/et_shell_cmd"
            android:layout_alignBottom="@id/et_shell_cmd"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_shell_hist_up"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arrow_btn"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:text="▲"
                android:textAllCaps="false"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_shell_hist_down"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arrow_btn_bottom"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:text="▼"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 底部操作行：Quick + Send -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button
            android:id="@+id/btn_shell_quick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:text="⌄CMD" />

        <Button
            android:id="@+id/btn_shell_send"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send" />
    </LinearLayout>

</LinearLayout>
